# Copy to .env and fill in values
GEMINI_API_KEY=your_ai_studio_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REQUESTS_PER_MINUTE=10

# Tapetide MCP (morning market news enrichment; optional)
# Same token as Cursor mcp.json env TAPETIDE_TOKEN — do not commit.
TAPETIDE_TOKEN=

# Fyers market data (https://myapi.fyers.in/docsv3)
# Prefer a non-trading app (no static IP needed for quotes/websocket).
FYERS_APP_ID=your_app_id-100
FYERS_SECRET_KEY=your_secret_id_from_dashboard
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
# 4-digit Fyers login PIN — required for automated daily refresh
FYERS_PIN=0000

# Filled by: python main.py fyers-login
# FYERS_ACCESS_TOKEN=APP_ID:eyJ...
# FYERS_REFRESH_TOKEN=...

# Morning auto-refresh (after login once):
#   python main.py fyers-refresh
#   or enable nse-trader-fyers-refresh.timer
