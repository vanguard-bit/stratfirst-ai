[Unit]
Description=NSE Trader local paper sim day (no broker orders)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=-__PROJECT_ROOT__/.env
ExecStartPre=/bin/mkdir -p __PROJECT_ROOT__/data/logs
ExecStart=__PROJECT_ROOT__/.venv/bin/python main.py paper --mode sim
Nice=10
MemoryMax=1G
StandardOutput=append:__PROJECT_ROOT__/data/logs/paper.log
StandardError=append:__PROJECT_ROOT__/data/logs/paper.log
