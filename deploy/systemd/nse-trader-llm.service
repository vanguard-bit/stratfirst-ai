[Unit]
Description=NSE Trader morning LLM feature extract (Gemini + optional MCP enrich)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=-__PROJECT_ROOT__/.env
ExecStartPre=/bin/mkdir -p __PROJECT_ROOT__/data/logs
ExecStart=__PROJECT_ROOT__/.venv/bin/python main.py llm-extract --slot morning
Nice=10
TimeoutStartSec=900
StandardOutput=append:__PROJECT_ROOT__/data/logs/llm-extract.log
StandardError=append:__PROJECT_ROOT__/data/logs/llm-extract.log
